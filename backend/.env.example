# LLM provider
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Frontend CORS
FRONTEND_ORIGINS=http://localhost:3000

# Data
DATA_DIR=/app/data
MAX_UPLOAD_MB=60
MAX_PDF_PAGES=1200

# Local embedding model
LOCAL_EMBEDDING_MODEL=/models/bge-m3
BGE_M3_HOST_PATH=./models/bge-m3

# Reranker
# Docker container path is configured in docker-compose.yml
RERANKER_HOST_PATH=./models/bge-reranker-base
ENABLE_RERANKER=1
RERANK_MIN_SCORE=-2.0